<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zamówienie Pizzy"
            android:textSize="22sp"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wybierz rodzaj pizzy:"/>

        <Spinner
            android:id="@+id/spPizzaType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wybierz rozmiar:"/>

        <RadioGroup
            android:id="@+id/rgSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <RadioButton
                android:id="@+id/rbSizeSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mała"/>

            <RadioButton
                android:id="@+id/rbSizeMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Średnia"/>

            <RadioButton
                android:id="@+id/rbSizeLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duża"/>
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodatki:"/>

        <CheckBox
            android:id="@+id/cbCheese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodatkowy ser"/>

        <CheckBox
            android:id="@+id/cbMushrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pieczarki"/>

        <CheckBox
            android:id="@+id/cbHam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Szynka"
            android:paddingBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ilość sztuk: "/>

            <TextView
                android:id="@+id/tvQuantityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="0"
            android:paddingBottom="16dp"/>

        <CheckBox
            android:id="@+id/swDelivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dostawa do domu"
            android:paddingBottom="16dp"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adres dostawy"
            android:inputType="textPostalAddress"
            android:visibility="gone"
            android:paddingBottom="16dp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Numer telefonu"
            android:inputType="phone"
            android:paddingBottom="24dp"/>

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Złóż zamówienie"/>

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>
